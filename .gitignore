# FoundIt - .gitignore

# Compiled binaries and object files
*.exe
*.o
*.obj
*.out
*.app
foundit_core
foundit_core.exe

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
